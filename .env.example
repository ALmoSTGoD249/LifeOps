# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=lifeops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lifeops
# generate: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
HTTP_PORT=8080
# 127.0.0.1 = reachable only through `tailscale serve` on the server (recommended).
# Use 0.0.0.0 to also allow plain-HTTP access from other LAN machines (then set COOKIE_SECURE=false).
BIND_ADDR=127.0.0.1
# Set false ONLY when serving over plain http on your LAN (no TLS in front)
COOKIE_SECURE=true
# Used once, on first start, to create the initial admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-long
ADMIN_NAME=Your Name
